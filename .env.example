# telegram-cli configuration
# No APP_ID/APP_HASH needed! User manages credentials locally.

# Path to telegram-cli binary (default: "tg")
# Set if tg is not in PATH
# TG_CLI_PATH=/usr/local/bin/tg

# telegram-cli config directory (default: ~/.telegram-cli)
# TG_CONFIG_DIR=~/.telegram-cli

# Phone number (optional, used for initial setup guidance)
PHONE_NUMBER=+1234567890

# Logging level
LOG_LEVEL=INFO
